<Window
    x:Class="Vitalis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral construit dans le code-behind (boutons). Remplace NavigationView, qui plantait au démarrage. -->
        <StackPanel
            x:Name="MenuPanneau"
            Grid.Column="0"
            Padding="12"
            Spacing="4" />

        <Frame x:Name="ContenuFrame" Grid.Column="1" />
    </Grid>

</Window>
