<Page
    x:Class="Vitalis.App.Views.TableauDeBordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure commune des pages : en-tête (titre, résumé, actions), puis le corps rempli par le code. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource VitalisContenuPage}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitrePage" Text="Tableau de bord" Style="{StaticResource VitalisTitrePage}" />
                <TextBlock x:Name="TexteResume" Text="Vue d'ensemble de l'état de votre PC." Style="{StaticResource VitalisDescription}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="BoutonAnalyser" Style="{StaticResource AccentButtonStyle}" Click="BoutonAnalyser_Click" AutomationProperties.Name="Analyser maintenant">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock x:Name="BoutonAnalyserTexte" Text="Analyser maintenant" />
                    </StackPanel>
                </Button>
                <Button x:Name="BoutonAnnuler" Visibility="Collapsed" Click="BoutonAnnuler_Click" AutomationProperties.Name="Annuler">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock x:Name="BoutonAnnulerTexte" Text="Annuler" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Corps" Spacing="16" />
        </StackPanel>
    </ScrollViewer>

</Page>
