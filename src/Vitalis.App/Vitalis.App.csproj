<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vitalis.App</RootNamespace>
    <!-- Nom simple de l'exécutable : Vitalis.exe. -->
    <AssemblyName>Vitalis</AssemblyName>
    <ApplicationIcon>Assets\Vitalis.ico</ApplicationIcon>
    <Product>Vitalis</Product>
    <AssemblyTitle>Vitalis - diagnostic du PC</AssemblyTitle>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Version portable (non empaquetée) pour l'étape 1. Le MSIX arrive à l'étape 12 (voir ADR-003). -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Désactive le Main généré par le compilateur XAML, remplacé par Program.cs (initialisation Bootstrap). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.8.251106002 : version qui correspond au runtime 1.8 installé. 1.8.260921001 plantait au premier NavigationView (voir ADR-003). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Exécutable autonome en un seul fichier : dotnet publish -c Release -p:Autonome=true.
       Embarque .NET et le Windows App SDK : rien à installer sur le PC cible (voir ADR-014).
       EnableMsixTooling est nécessaire pour que la publication produise le fichier .pri (ressources XAML). -->
  <PropertyGroup Condition="'$(Autonome)' == 'true'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);VITALIS_AUTONOME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vitalis.Core\Vitalis.Core.csproj" />
  </ItemGroup>

</Project>
