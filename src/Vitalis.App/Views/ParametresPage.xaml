<Page
    x:Class="Vitalis.App.Views.ParametresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock
                Text="Paramètres"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />

            <TextBlock
                Text="Thème"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <ComboBox x:Name="ChoixTheme" SelectionChanged="ChoixTheme_SelectionChanged" AutomationProperties.Name="Thème de l'application">
                <ComboBoxItem Content="Suivre Windows" Tag="Systeme" />
                <ComboBoxItem Content="Clair" Tag="Clair" />
                <ComboBoxItem Content="Sombre" Tag="Sombre" />
            </ComboBox>

            <TextBlock
                Text="Diagnostic"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <ToggleSwitch
                x:Name="ModeDiagnostic"
                Header="Mode diagnostic (journal détaillé)"
                Toggled="ModeDiagnostic_Toggled" />
            <TextBlock
                Text="Le journal détaillé prend effet au prochain démarrage. Il ne contient ni nom d'utilisateur, ni nom de machine, ni numéro de série."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />

            <Button Content="Ouvrir le dossier des journaux" Click="BoutonJournaux_Click" />

            <TextBlock
                x:Name="TexteStatut"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>

</Page>
