<Page
    x:Class="Vitalis.App.Views.DemarragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock
                Text="Démarrage"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <TextBlock
                x:Name="TexteResume"
                Text="Lecture des programmes de démarrage…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
            <TextBlock
                Text="Désactiver retire le programme du démarrage, mais sauvegarde sa commande : « Réactiver » la rétablit à l'identique. Rien n'est supprimé du disque."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
            <TextBlock
                Text="Programmes au démarrage"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <StackPanel x:Name="ListeEntrees" Spacing="10" />
            <TextBlock
                Text="Désactivés par Vitalis"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <StackPanel x:Name="ListeDesactivees" Spacing="10" />
        </StackPanel>
    </ScrollViewer>

</Page>
