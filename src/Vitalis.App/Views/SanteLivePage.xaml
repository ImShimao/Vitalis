<Page
    x:Class="Vitalis.App.Views.SanteLivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure commune des pages : en-tête (titre, résumé, actions), puis le corps rempli par le code. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource VitalisContenuPage}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Santé live" Style="{StaticResource VitalisTitrePage}" />
                <TextBlock Text="Températures, charges, fréquences et ventilateurs, mis à jour toutes les deux secondes." Style="{StaticResource VitalisDescription}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="BoutonPause" Click="BoutonPause_Click" AutomationProperties.Name="Mettre en pause">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="IconePause" Glyph="&#xE769;" FontSize="14" />
                        <TextBlock x:Name="TextePause" Text="Pause" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Messages" Spacing="8" />
        <StackPanel x:Name="Corps" Spacing="16" />
        </StackPanel>
    </ScrollViewer>

</Page>
