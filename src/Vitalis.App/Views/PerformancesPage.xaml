<Page
    x:Class="Vitalis.App.Views.PerformancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure commune des pages : en-tête (titre, résumé, actions), puis le corps rempli par le code. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource VitalisContenuPage}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitrePage" Text="Performances" Style="{StaticResource VitalisTitrePage}" />
                <TextBlock x:Name="TexteResume" Text="Mesures rapides pour comparer deux analyses sur ce PC. Ce ne sont pas des scores officiels." Style="{StaticResource VitalisDescription}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="BoutonLancer" Style="{StaticResource AccentButtonStyle}" Click="BoutonLancer_Click" AutomationProperties.Name="Lancer les mesures">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="BoutonLancerTexte" Text="Lancer les mesures" />
                    </StackPanel>
                </Button>
                <Button x:Name="BoutonAnnuler" Visibility="Collapsed" Click="BoutonAnnuler_Click" AutomationProperties.Name="Annuler">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock x:Name="BoutonAnnulerTexte" Text="Annuler" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Corps" Spacing="16" />
        </StackPanel>
    </ScrollViewer>

</Page>
