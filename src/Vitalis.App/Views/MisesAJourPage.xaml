<Page
    x:Class="Vitalis.App.Views.MisesAJourPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock
                Text="Mises à jour"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <TextBlock
                x:Name="TexteResume"
                Text="Recherche en cours…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
            <TextBlock
                Text="Windows Update"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <StackPanel x:Name="ListeMises" Spacing="8" />
            <TextBlock
                Text="Logiciels (winget)"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <StackPanel x:Name="ListeLogiciels" Spacing="8" />
        </StackPanel>
    </ScrollViewer>

</Page>
