<Page
    x:Class="Vitalis.App.Views.PerformancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock
                Text="Performances"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexte}" />
            <TextBlock
                Text="Ces mesures durent quelques secondes. Elles servent à comparer deux analyses sur cette machine, pas à établir un score officiel. Chaque résultat indique sa méthode et ses limites."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="BoutonLancer" Content="Lancer les benchmarks" Click="BoutonLancer_Click" />
                <ProgressRing x:Name="Attente" IsActive="False" Width="24" Height="24" />
            </StackPanel>
            <TextBlock
                x:Name="TexteStatut"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource VitalisTexteSecondaire}"
                TextWrapping="Wrap" />
            <StackPanel x:Name="ListeResultats" Spacing="10" />
        </StackPanel>
    </ScrollViewer>

</Page>
